.c-input {
  height: 76rpx;
  background-color: var(--fill-base);
  border-radius: 38rpx;
  padding: 10rpx 20rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.c-input__field {
  flex: 1;
  padding: 0 20rpx;
  font-size: var(--font-size-body);
  color: var(--text-primary);
}

.c-input__placeholder {
  color: var(--text-annotation);
  font-size: var(--font-size-body);
}

.c-input__btn {
  width: 76rpx;
  height: 56rpx;
  background-color: var(--color-primary-blue);
  border-radius: 28rpx;
  flex-shrink: 0;
}

.c-input__icon {
  width: 28rpx;
  height: 28rpx;
}
