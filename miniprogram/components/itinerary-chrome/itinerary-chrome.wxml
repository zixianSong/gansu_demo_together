<view class="chrome">
  <view class="chrome-status" style="height: {{statusBarHeight}}px;"></view>
  <view class="chrome-head" style="height: {{navHeight}}px;">
    <view class="chrome-head__back" bindtap="goBack" aria-role="button" aria-label="返回">
      <view class="chrome-head__back-icon"></view>
    </view>
    <text class="chrome-head__title">行程管理</text>
  </view>
  <view class="view-row">
    <scroll-view class="view-tabs" scroll-x enhanced show-scrollbar="{{false}}" enable-flex>
      <view class="view-tabs__inner">
        <view class="tab {{active === 'multiday' ? 'is-active' : ''}}" data-view="multiday" bindtap="goView">多日视图</view>
        <view class="tab {{active === 'map' ? 'is-active' : ''}}" data-view="map" bindtap="goView">地图视图</view>
        <view class="tab {{active === 'singleday' ? 'is-active' : ''}}" data-view="singleday" bindtap="goView">单日视图</view>
        <view class="tab {{active === 'overview' ? 'is-active' : ''}}" data-view="overview" bindtap="goView">总览视图</view>
      </view>
    </scroll-view>
    <view class="view-more" bindtap="toggleMore" aria-role="button" aria-label="更多">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
  </view>

  <view class="more-pop" wx:if="{{showMore}}" catchtap="closeMore">
    <view class="more-pop__panel" style="top: {{morePanelTop}}px;" catchtap="">
      <view class="more-pop__item" bindtap="openHist">历史版本</view>
      <view class="more-pop__item" bindtap="goPlans">我的方案集</view>
      <view class="more-pop__item" bindtap="goSummary">行程总结</view>
    </view>
  </view>

  <view class="hist-mask" wx:if="{{showHist}}" bindtap="closeHist">
    <view class="hist-sheet" catchtap="">
      <view class="hist-bar">
        <text>历史版本</text>
        <text bindtap="closeHist">关闭</text>
      </view>
      <view class="hist-item" wx:for="{{snapshots}}" wx:key="id" data-id="{{item.id}}" bindtap="restore">
        <text>{{item.createdAt}}</text>
      </view>
      <view class="hist-empty" wx:if="{{!snapshots.length}}">暂无历史快照（确认调整后才会生成）</view>
    </view>
  </view>
</view>
