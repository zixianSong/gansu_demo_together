.chrome {
  background: #fff;
  position: relative;
  z-index: 20;
  flex-shrink: 0;
}
.chrome-status {
  width: 100%;
  background: #fff;
}
.chrome-head {
  position: relative;
  background: #fff;
  display: flex;
  align-items: center;
}
.chrome-head__back {
  position: relative;
  z-index: 2;
  width: 36px;
  height: 36px;
  margin-left: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chrome-head__back-icon {
  width: 10px;
  height: 10px;
  border-left: 2px solid #000;
  border-bottom: 2px solid #000;
  transform: rotate(45deg);
  margin-left: 4px;
}
.chrome-head__title {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  text-align: center;
  font-size: 22px;
  line-height: 26px;
  letter-spacing: 0.4px;
  color: #3d3d3d;
  font-weight: 400;
  pointer-events: none;
}
.view-row {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 0 4px 12px 5px;
  background: #fff;
}
.view-tabs {
  flex: 1;
  width: 0;
  height: 36px;
  white-space: nowrap;
}
.view-tabs__inner {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  height: 36px;
  padding-right: 4px;
}
.tab {
  flex: none;
  height: 36px;
  line-height: 36px;
  padding: 0 12px;
  text-align: center;
  font-size: 13px;
  color: #000;
  background: #f5e6de;
  border-radius: 15px;
  white-space: nowrap;
}
.tab.is-active {
  background: #2b6eea;
  color: #fff;
  font-weight: 600;
}
.view-more {
  flex: none;
  width: 36px;
  height: 36px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
}
.dot {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: #111;
}
.more-pop {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
}
.more-pop__panel {
  position: absolute;
  right: 8px;
  width: 160px;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
}
.more-pop__item {
  padding: 14px 16px;
  font-size: 14px;
  border-top: 1px solid #f3f4f6;
}
.more-pop__item:first-child {
  border-top: 0;
}
.hist-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.4);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.hist-sheet {
  width: 100%;
  background: #fff;
  border-radius: 16px 16px 0 0;
  padding: 16px 16px 32px;
  max-height: 70vh;
}
.hist-bar {
  display: flex;
  justify-content: space-between;
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 12px;
}
.hist-item {
  padding: 12px 0;
  border-bottom: 1px solid #f3f4f6;
  font-size: 13px;
}
.hist-empty {
  color: #6b7280;
  font-size: 13px;
  padding: 12px 0;
}
