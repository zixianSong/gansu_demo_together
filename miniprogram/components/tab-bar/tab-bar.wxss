.tab-bar {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #000000;
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-text {
  font-size: 20rpx;
  line-height: 28rpx;
  color: #a6a6a6;
}

.tab-text--active {
  color: #1677ff;
}
