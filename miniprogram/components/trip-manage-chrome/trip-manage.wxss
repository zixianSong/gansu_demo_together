page {
  background: #f7f7f8;
  color: #3d3d3d;
  font-size: 14px;
}
.alert {
  margin: 12px;
  padding: 12px;
  background: linear-gradient(90deg, #fef2f2, #fff7ed);
  border-radius: 12px;
}
.alert__text {
  font-size: 13px;
  color: #991b1b;
  line-height: 1.5;
}
.alert__row {
  display: flex;
  gap: 8px;
  margin-top: 8px;
  align-items: center;
}
.alert__btn {
  background: #ef4444;
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  padding: 4px 12px;
  border-radius: 8px;
}
.alert__ignore {
  color: #f87171;
  font-size: 12px;
}
.card {
  background: #fff;
  border-radius: 12px;
  padding: 12px;
  margin: 0 12px 12px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}
.card__title {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 6px;
}
.meta {
  font-size: 12px;
  color: #928da0;
}
.footer-btn {
  margin: 16px 16px 32px;
  height: 48px;
  line-height: 48px;
  text-align: center;
  background: #1677ff;
  color: #fff;
  border-radius: 8px;
  font-weight: 600;
}
.empty {
  padding: 48px 16px;
  text-align: center;
  color: #6b7280;
}
.tag {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 999px;
  margin-right: 6px;
}
.tag-on {
  background: #eff6ff;
  color: #1d4ed8;
}
.tag-draft {
  background: #fff8e7;
  color: #d97706;
}
.tag-arc {
  background: #f3f4f6;
  color: #6b7280;
}
.btn-row {
  display: flex;
  gap: 8px;
  margin-top: 10px;
}
.btn {
  height: 36px;
  line-height: 36px;
  padding: 0 12px;
  border-radius: 10px;
  font-size: 12px;
  font-weight: 600;
}
.btn-pri {
  background: #2563eb;
  color: #fff;
}
.btn-ghost {
  background: #f3f4f6;
  color: #374151;
}
.sec {
  margin: 16px 16px 8px;
  font-weight: 700;
}
