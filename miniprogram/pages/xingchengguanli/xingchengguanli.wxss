@import '../../styles/itinerary.wxss';

.page {
  min-height: 100vh;
  background: #f7f7f8;
  padding-bottom: 16px;
}

.alert {
  margin: 0 16px;
  border-radius: 16px;
  border: 1px solid rgba(254, 202, 202, 0.7);
  background: linear-gradient(90deg, #fef2f2 0%, #fdf6f3 100%);
  display: flex;
  gap: 10px;
  padding: 13px 16px 13px 12px;
  position: relative;
  overflow: hidden;
}
.alert::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  background: #ef4444;
}
.alert__icon {
  width: 32px;
  height: 32px;
  border-radius: 12px;
  background: #fee2e2;
  color: #ef4444;
  font-size: 16px;
  font-weight: 700;
  line-height: 32px;
  text-align: center;
  flex: none;
}
.alert__body {
  flex: 1;
  min-width: 0;
}
.alert__text {
  color: #991b1b;
  font-size: 12px;
  font-weight: 600;
  line-height: 16px;
}
.alert__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12px;
  gap: 8px;
}
.alert__btn {
  height: 28px;
  line-height: 28px;
  padding: 0 12px;
  border-radius: 8px;
  background: #ef4444;
  color: #fff;
  font-size: 11px;
  font-weight: 600;
}
.alert__more {
  color: #f87171;
  font-size: 10px;
  line-height: 15px;
}

.date-row {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 16px 8px;
}
.map-fab {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.map-fab__pin {
  width: 10px;
  height: 10px;
  border-radius: 50% 50% 50% 0;
  background: #0f172a;
  transform: rotate(-45deg);
}
.date-card {
  flex: 1;
  min-height: 62px;
  background: #fff;
  border-radius: 16px;
  box-shadow: 0 1px 8px rgba(53, 50, 60, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px;
  margin: 0;
}
.date-card__left {
  display: flex;
  align-items: center;
  gap: 8px;
}
.date-card__icon {
  width: 32px;
  height: 32px;
  border-radius: 12px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 12px;
  font-weight: 700;
  line-height: 32px;
  text-align: center;
}
.date-card__label {
  font-size: 10px;
  font-weight: 500;
  color: #928da0;
  line-height: 15px;
}
.date-card__range {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  font-weight: 600;
  color: #3d3a46;
}
.date-card__sep {
  color: #928da0;
}
.optimize {
  position: relative;
  display: flex;
  align-items: center;
  height: 38px;
  padding: 0 10px;
  background: #fffbeb;
  border: 1px solid rgba(253, 230, 138, 0.6);
  border-radius: 8px;
  color: #b45309;
  font-size: 10px;
  font-weight: 500;
}
.optimize__badge {
  position: absolute;
  top: -6px;
  left: 4px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #c26a4a;
  color: #fff;
  font-size: 7px;
  font-weight: 700;
  line-height: 12px;
  text-align: center;
}

.timeline {
  padding: 8px 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.day {
  display: flex;
  align-items: stretch;
  gap: 16px;
}
.day__rail {
  width: 12px;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.day__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #1677ff;
  flex: none;
  margin-top: 8px;
}
.day__line {
  width: 2px;
  flex: 1;
  background: #d9d9d9;
  margin-top: 4px;
  min-height: 24px;
}
.day__body {
  flex: 1;
  min-width: 0;
}
.day__head {
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.day__title {
  display: flex;
  align-items: center;
  gap: 12px;
}
.day__name {
  font-size: 16px;
  font-weight: 700;
  line-height: 24px;
  color: #252525;
}
.day__date {
  font-size: 12px;
  line-height: 16px;
  color: #8c8c8c;
}
.day__more {
  width: 16px;
  color: #8c8c8c;
  font-size: 12px;
}
.day-card {
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  overflow: hidden;
}
.spot-cover {
  height: 120px;
  display: flex;
  align-items: flex-end;
  padding: 12px;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  background-size: cover;
  background-position: center;
}
.cover-0 {
  background-image: linear-gradient(180deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.45)),
    linear-gradient(135deg, #c4a574, #8b5a2b);
}
.cover-1 {
  background-image: linear-gradient(180deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.45)),
    linear-gradient(135deg, #e8b56a, #c26a2d);
}
.cover-2 {
  background-image: linear-gradient(180deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.45)),
    linear-gradient(135deg, #4aa3c7, #1d6f8a);
}
.spot-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px;
}
.spot-meta__item {
  flex: 1;
  min-width: 0;
  color: #8c8c8c;
  font-size: 12px;
  line-height: 16px;
}
.spot-hint {
  flex: 1;
  background: #e8f4ff;
  border-radius: 4px;
  min-height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-size: 10px;
  font-weight: 500;
  line-height: 16px;
  padding: 4px 6px;
  text-align: center;
}
.transport {
  padding: 16px 20px;
  background: #fafafa;
  border-bottom: 1px solid #f0f0f0;
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.mode {
  width: 32px;
  flex: none;
  text-align: center;
}
.mode__icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: #fff7e6;
  color: #fa8c16;
  font-size: 12px;
  font-weight: 700;
  line-height: 32px;
  margin-bottom: 4px;
}
.mode__label {
  font-size: 10px;
  line-height: 14px;
  color: #3d3d3d;
}
.transport__info {
  flex: 1;
  min-width: 0;
}
.transport__plan {
  font-size: 12px;
  font-weight: 600;
  color: #1f1f1f;
}
.transport__name {
  margin-top: 4px;
  font-size: 12px;
  color: #928da0;
}

.footer {
  margin-top: 8px;
  background: rgba(255, 255, 255, 0.95);
  border-top: 1px solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px 16px 16px;
}
.footer__btn {
  width: 100%;
  height: 48px;
  line-height: 48px;
  text-align: center;
  border-radius: 8px;
  background: #1677ff;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  box-shadow: 0 4px 16px rgba(22, 119, 255, 0.2);
}
.empty {
  padding: 48px 16px;
}
