<view class="chat-page">
  <scroll-view
    class="chat-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-into-view="{{anchor}}"
    scroll-with-animation
  >
    <view id="top" class="chat-pad"></view>

    <view class="row row--ai">
      <view class="avatar avatar--ai">AI</view>
      <view class="col">
        <view class="bubble bubble--ai">{{welcome}}</view>
      </view>
    </view>

    <block wx:for="{{messages}}" wx:key="id">
      <view class="row {{item.role === 'user' ? 'row--me' : 'row--ai'}}" id="m{{item.id}}">
        <view class="avatar avatar--ai" wx:if="{{item.role === 'ai'}}">AI</view>
        <view class="col {{item.role === 'user' ? 'col--me' : ''}}">
          <view class="bubble {{item.role === 'user' ? 'bubble--me' : 'bubble--ai'}}" wx:if="{{item.text}}">{{item.text}}</view>
          <view class="plan-card" wx:if="{{item.planItems.length}}">
            <view class="plan-card__hd">{{item.planName || '行程方案预览'}}</view>
            <view class="plan-card__row" wx:for="{{item.planItems}}" wx:for-item="node" wx:key="name">
              <text>{{node.name || '未命名节点'}}</text>
              <text class="plan-card__meta">{{node.type}} {{node.date}}</text>
            </view>
            <view class="plan-card__btn" bindtap="toastApply">确认后写入行程</view>
          </view>
          <view class="plan-card plan-card--empty" wx:elif="{{item.role === 'ai' && item.showEmptyPlan}}">
            <view class="plan-card__hd">行程方案</view>
            <view class="plan-card__meta">还没有可预览的方案。补充天数和目的地后，我会把方案放在对话里。</view>
          </view>
        </view>
        <view class="avatar avatar--me" wx:if="{{item.role === 'user'}}">我</view>
      </view>
    </block>

    <view class="chips" wx:if="{{showChips}}">
      <view class="chip" wx:for="{{chips}}" wx:key="*this" data-text="{{item}}" bindtap="chip">{{item}}</view>
    </view>

    <view id="bottom" class="chat-pad chat-pad--end"></view>
  </scroll-view>

  <view class="composer">
    <input
      class="composer__input"
      placeholder="发消息给行程助手"
      value="{{draft}}"
      confirm-type="send"
      bindinput="onInput"
      bindconfirm="send"
    />
    <view class="composer__send {{draft ? 'is-on' : ''}}" bindtap="send">发送</view>
  </view>
</view>
