.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ededed;
}
.chat-scroll {
  flex: 1;
  height: 0;
}
.chat-pad {
  height: 12px;
}
.chat-pad--end {
  height: 8px;
}
.row {
  display: flex;
  align-items: flex-start;
  padding: 8px 12px;
  gap: 8px;
}
.row--me {
  justify-content: flex-end;
}
.col {
  max-width: 72%;
  min-width: 0;
}
.col--me {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.avatar {
  width: 40px;
  height: 40px;
  border-radius: 6px;
  flex-shrink: 0;
  font-size: 12px;
  color: #fff;
  text-align: center;
  line-height: 40px;
}
.avatar--ai {
  background: #07c160;
}
.avatar--me {
  background: #3d8bfd;
}
.bubble {
  padding: 10px 12px;
  border-radius: 8px;
  font-size: 15px;
  line-height: 1.55;
  word-break: break-word;
}
.bubble--ai {
  background: #fff;
  color: #111;
}
.bubble--me {
  background: #95ec69;
  color: #111;
}
.plan-card {
  margin-top: 8px;
  background: #fff;
  border-radius: 8px;
  padding: 10px 12px 12px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
}
.plan-card--empty {
  color: #888;
}
.plan-card__hd {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 8px;
}
.plan-card__row {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 0;
  border-top: 1px solid #f3f4f6;
  font-size: 13px;
}
.plan-card__meta {
  color: #888;
  font-size: 12px;
  flex-shrink: 0;
}
.plan-card__btn {
  margin-top: 10px;
  height: 36px;
  line-height: 36px;
  text-align: center;
  background: #07c160;
  color: #fff;
  border-radius: 6px;
  font-size: 14px;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 4px 12px 12px;
}
.chip {
  background: #fff;
  border-radius: 999px;
  padding: 7px 12px;
  font-size: 13px;
  color: #333;
}
.composer {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px calc(8px + env(safe-area-inset-bottom));
  background: #f7f7f7;
  border-top: 1px solid #e5e5e5;
}
.composer__input {
  flex: 1;
  height: 36px;
  background: #fff;
  border-radius: 6px;
  padding: 0 10px;
  font-size: 15px;
}
.composer__send {
  min-width: 52px;
  height: 36px;
  line-height: 36px;
  text-align: center;
  border-radius: 6px;
  font-size: 15px;
  color: #bbb;
  background: #e9e9e9;
}
.composer__send.is-on {
  color: #fff;
  background: #07c160;
}
