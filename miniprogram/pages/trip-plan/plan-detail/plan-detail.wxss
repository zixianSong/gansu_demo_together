@import '../../../components/trip-manage-chrome/trip-manage.wxss';
.tabs {
  display: flex;
  justify-content: center;
  gap: 32px;
  background: #fff;
}
.tabs .on {
  color: #1677ff;
  font-weight: 600;
  padding-bottom: 10px;
  box-shadow: inset 0 -2px 0 #1677ff;
}
.tabs text {
  padding: 12px 0;
}
.row {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid #f3f4f6;
  font-size: 13px;
}
