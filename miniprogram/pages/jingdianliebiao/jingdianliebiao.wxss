.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.search-wrap {
  background-color: var(--color-white);
  padding: 20rpx var(--page-padding-horizontal);
}

.list-scroll {
  flex: 1;
  height: 0;
  padding-top: 20rpx;
}

.spot-list {
  padding: 0 var(--page-padding-horizontal);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.spot-card {
  display: flex;
  background-color: var(--color-white);
  border-radius: var(--radius-medium);
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.spot-cover {
  width: 220rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.spot-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.spot-name {
  color: var(--text-primary);
  font-size: var(--font-size-body-large);
  font-weight: var(--font-weight-bold);
}

.spot-city {
  color: var(--text-annotation);
  font-size: var(--font-size-caption);
}

.spot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.spot-tag {
  background-color: var(--fill-base);
  border-radius: var(--radius-small);
  padding: 4rpx 12rpx;
  color: var(--text-secondary);
  font-size: var(--font-size-tag);
}

.spot-price {
  margin-top: auto;
  color: var(--color-danger);
  font-size: var(--font-size-heading);
  font-weight: var(--font-weight-bold);
  font-family: var(--font-family-number);
}

.empty {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
}

.empty-text {
  color: var(--text-annotation);
  font-size: var(--font-size-secondary);
}

.safe-bottom {
  height: 40rpx;
}
