page {
  height: 100%;
  background: #f1f5f9;
}
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f1f5f9;
}
.day-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 20px 12px;
  background: #fff;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
}
.day-switch__btn {
  width: 40px;
  height: 40px;
  line-height: 40px;
  text-align: center;
  border-radius: 16px;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  color: #a8a29e;
  font-size: 20px;
}
.day-switch__center {
  flex: 1;
  text-align: center;
}
.day-switch__date {
  font-size: 20px;
  font-weight: 700;
  line-height: 28px;
}
.day-switch__meta {
  font-size: 12px;
  color: #a8a29e;
}
.map-stage {
  flex: 1;
  position: relative;
  min-height: 280px;
}
.map {
  width: 100%;
  height: 100%;
}
.days {
  white-space: nowrap;
  padding: 0 12px 10px;
  background: #fff;
}
.days__item {
  display: inline-block;
  min-width: 64px;
  margin-right: 8px;
  padding: 8px 10px;
  border-radius: 12px;
  background: #f1f5f9;
  font-size: 11px;
  color: #64748b;
  text-align: center;
}
.days__item.is-on {
  background: #2b6eea;
  color: #fff;
}
.days__date {
  font-size: 12px;
  font-weight: 700;
  margin-top: 2px;
}
.sheet {
  background: #fff;
  border-radius: 20px 20px 0 0;
  padding: 10px 16px calc(16px + env(safe-area-inset-bottom));
  box-shadow: 0 -8px 24px rgba(15, 23, 42, 0.12);
}
.sheet__handle {
  width: 36px;
  height: 4px;
  border-radius: 999px;
  background: #e5e7eb;
  margin: 0 auto 12px;
}
.sheet__row {
  display: flex;
  align-items: center;
  gap: 12px;
}
.sheet__badge {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  flex-shrink: 0;
}
.sheet__body {
  flex: 1;
  min-width: 0;
}
.sheet__title {
  font-size: 16px;
  font-weight: 700;
}
.sheet__meta {
  margin-top: 4px;
  font-size: 12px;
  color: #928da0;
}
.sheet__more {
  font-size: 22px;
  color: #cbd5e1;
}
