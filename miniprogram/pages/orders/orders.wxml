<view class="page-container orders-page">
  <view class="search-bar">
    <input class="search-input" placeholder="商品名称/订单号" value="{{keyword}}" bindinput="onSearch" />
  </view>

  <view class="tabs">
    <view
      class="tab {{activeTab === item.key ? 'tab--active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >
      {{item.label}}
    </view>
  </view>

  <view wx:if="{{list.length}}" class="list">
    <view class="order-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenDetail">
      <view class="order-top">
        <text class="order-cat">{{item.category}}</text>
        <text class="order-status">{{item.statusText}}</text>
      </view>
      <view class="order-body">
        <view class="order-info">
          <text class="order-title">{{item.title}}</text>
          <text class="order-meta">有效期：{{item.validDate}}</text>
          <text class="order-meta">份数：{{item.count}}</text>
          <text class="order-meta">使用方式：{{item.usage}}</text>
        </view>
        <view class="order-price-wrap">
          <text class="order-price">¥{{item.price}}</text>
          <text class="order-pay">{{item.payHint}}</text>
        </view>
      </view>
      <view class="order-actions">
        <button
          wx:for="{{item.actionButtons}}"
          wx:for-item="btn"
          wx:key="key"
          size="mini"
          class="action-btn {{btn.primary ? 'action-btn--primary' : 'action-btn--ghost'}}"
          catchtap="onAction"
          data-action="{{btn.key}}"
          data-id="{{item.id}}"
        >{{btn.label}}</button>
      </view>
    </view>
  </view>

  <view wx:else class="empty">
    <text>暂无相关订单</text>
  </view>

  <view class="history">历史订单</view>
</view>
