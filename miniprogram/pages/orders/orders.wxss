.orders-page {
  padding-bottom: var(--space-xl);
}

.search-bar {
  background-color: var(--color-white);
  padding: var(--space-sm) var(--page-padding-horizontal);
}

.search-input {
  height: var(--input-height);
  padding: 0 var(--page-padding-horizontal);
  background-color: var(--fill-base);
  border-radius: var(--radius-full);
  font-size: var(--font-size-caption);
}

.tabs {
  display: flex;
  background-color: var(--color-white);
  border-bottom: var(--hairline) solid var(--fill-base);
}

.tab {
  flex: 1;
  text-align: center;
  padding: var(--space-md) 0;
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
  border-bottom: var(--space-xs) solid transparent;
}

.tab--active {
  color: var(--color-primary-blue);
  font-weight: var(--font-weight-medium);
  border-bottom-color: var(--color-primary-blue);
}

.list {
  padding: var(--space-lg) var(--page-padding-horizontal) 0;
}

.order-card {
  background-color: var(--color-white);
  border-radius: var(--radius-large);
  box-shadow: var(--shadow-card);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
}

.order-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.order-cat,
.order-status,
.order-meta,
.order-pay {
  font-size: var(--font-size-caption);
  color: var(--text-annotation);
}

.order-body {
  display: flex;
  justify-content: space-between;
  margin-bottom: var(--space-lg);
}

.order-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.order-title {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
}

.order-price-wrap {
  margin-left: var(--space-lg);
  text-align: right;
  flex-shrink: 0;
}

.order-price {
  font-family: var(--font-family-number);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-bold);
  color: var(--text-secondary);
}

.order-actions {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  justify-content: flex-end;
  align-items: center;
  gap: var(--space-sm);
}

.order-actions button.action-btn {
  margin: 0;
  width: auto;
  min-width: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  font-size: var(--font-size-caption);
  border-radius: var(--radius-full);
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.order-actions button.action-btn::after {
  border: none;
}

.action-btn--ghost {
  background-color: var(--color-white);
  color: var(--text-secondary);
  border: 2rpx solid #e5e5e5;
}

.action-btn--primary {
  background-color: var(--color-primary-blue);
  color: var(--color-white);
  border: 2rpx solid var(--color-primary-blue);
}

.empty,
.history {
  padding: var(--space-xl) 0;
  text-align: center;
  font-size: var(--font-size-caption);
  color: var(--text-annotation);
}
