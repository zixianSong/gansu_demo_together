<view class="page-container profile-page">
  <view class="form-card">
    <view class="form-row">
      <text class="label">姓名</text>
      <input class="value-input" value="{{name}}" placeholder="与证件一致" bindinput="onName" />
    </view>
    <view class="form-row">
      <text class="label">证件号</text>
      <input class="value-input" value="{{idNumber}}" placeholder="{{idHint}}" bindinput="onId" />
    </view>
    <view class="form-row">
      <text class="label">手机号</text>
      <input class="value-input" value="{{phone}}" placeholder="不修改请留空" bindinput="onPhone" />
    </view>
  </view>
  <view class="save-bar">
    <button class="btn-primary save-btn" bindtap="onSave">保存</button>
  </view>
</view>
