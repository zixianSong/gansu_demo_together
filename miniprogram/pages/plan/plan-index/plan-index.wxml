<view class="page">
  <view class="head">
    <text class="head__new" bindtap="openNew">新建方案</text>
  </view>

  <view class="empty-box" wx:if="{{isEmpty}}">
    <view class="empty-box__title">暂无方案，快去旅行规划吧</view>
    <view class="empty-box__btn" bindtap="openNew">新建方案</view>
  </view>

  <block wx:else>
    <view class="card" wx:if="{{current}}">
      <text class="tag tag-on">当前方案</text>
      <view class="card__title">{{current.name}}</view>
      <view class="meta">{{current.attractionSummary}}</view>
      <view class="btn-row">
        <view class="btn btn-pri" bindtap="goCurrent">查看/编辑当前方案</view>
      </view>
    </view>

    <view class="sec" wx:if="{{drafts.length}}">草稿箱（{{drafts.length}}个）</view>
    <view class="card" wx:for="{{drafts}}" wx:key="id">
      <text class="tag tag-draft">草稿</text>
      <view class="card__title">{{item.name}}</view>
      <view class="meta">{{item.attractionSummary}}</view>
      <view class="btn-row">
        <view class="btn btn-pri" data-id="{{item.id}}" bindtap="goSwitch">切换为当前方案</view>
      </view>
    </view>

    <view class="sec" wx:if="{{archived.length}}">已存档（{{archived.length}}个）</view>
    <view class="card" wx:for="{{archived}}" wx:key="id">
      <text class="tag tag-arc">已存档</text>
      <view class="card__title">{{item.name}}</view>
      <view class="btn-row">
        <view class="btn btn-ghost" data-id="{{item.id}}" bindtap="goSwitch">切换为当前方案</view>
      </view>
    </view>
  </block>

  <view class="mask" wx:if="{{showNew}}" catchtap="closeNew">
    <view class="sheet" catchtap="">
      <view class="sheet__title">新建行程方案</view>
      <view class="sheet__desc">选择一种方式创建您的甘肃之旅</view>
      <view class="choice">
        <view class="choice__item" bindtap="pickClassic">
          <text class="choice__name">经典线路</text>
          <text class="choice__meta">选择系统预设的经典线路模板</text>
        </view>
        <view class="choice__item" bindtap="pickCustom">
          <text class="choice__name">自主定制</text>
          <text class="choice__meta">AI智能生成或从零开始手动规划</text>
        </view>
      </view>
      <view class="sheet__cancel" bindtap="closeNew">取消</view>
    </view>
  </view>
</view>
