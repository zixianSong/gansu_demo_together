@import '../../../components/trip-manage-chrome/trip-manage.wxss';

page {
  background: #f5f0e8;
  color: #3d3a46;
}

.page {
  min-height: 100vh;
  background: #f5f0e8;
  padding-bottom: 32px;
}

.head {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 8px 16px;
  background: #f5f0e8;
}

.head__new {
  font-size: 14px;
  color: #2563eb;
}

.empty-box {
  padding: 80px 32px 32px;
  text-align: center;
}

.empty-box__title {
  font-size: 16px;
  font-weight: 600;
  color: #3d3a46;
  line-height: 1.6;
}

.empty-box__btn {
  margin: 24px auto 0;
  width: 160px;
  height: 44px;
  line-height: 44px;
  text-align: center;
  background: #2563eb;
  color: #fff;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
}

.card {
  background: #fff;
  border-radius: 16px;
  padding: 16px;
  margin: 0 16px 12px;
  box-shadow: 0 4px 16px rgba(53, 50, 60, 0.06);
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.4);
  z-index: 30;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 20px 20px 0 0;
  padding: 20px 20px calc(28px + env(safe-area-inset-bottom));
}

.sheet__title {
  font-size: 16px;
  font-weight: 700;
}

.sheet__desc {
  font-size: 13px;
  color: #6b7280;
  line-height: 1.6;
  margin-top: 8px;
}

.choice {
  display: flex;
  gap: 12px;
  margin: 16px 0;
}

.choice__item {
  flex: 1;
  min-height: 120px;
  border-radius: 16px;
  border: 1px solid #e7e5e4;
  background: #fafaf9;
  padding: 16px;
}

.choice__name {
  display: block;
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 8px;
}

.choice__meta {
  display: block;
  font-size: 12px;
  color: #928da0;
  line-height: 1.5;
}

.sheet__cancel {
  height: 44px;
  line-height: 44px;
  text-align: center;
  background: #f3f4f6;
  color: #374151;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
}
