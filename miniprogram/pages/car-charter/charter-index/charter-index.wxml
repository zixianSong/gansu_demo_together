<view class="page">
  <view class="mode-row">
    <view class="mode-card {{mode === 'line' ? 'mode-card--on' : ''}}" bindtap="onLineTap">
      <text class="mode-title {{mode === 'line' ? 'mode-title--on' : ''}}">按线路包车</text>
      <text class="mode-sub {{mode === 'line' ? 'mode-sub--on' : ''}}">经典周边 一口价</text>
    </view>
    <view class="mode-card {{mode === 'hourly' ? 'mode-card--on' : ''}}" bindtap="onHourTap">
      <text class="mode-title {{mode === 'hourly' ? 'mode-title--on' : ''}}">按小时包车</text>
      <text class="mode-sub {{mode === 'hourly' ? 'mode-sub--on' : ''}}">随走随停 自由安排</text>
    </view>
  </view>

  <view class="filter-block">
    <view class="pick-row">
      <view class="pick-card" bindtap="onCityPick">
        <view class="pin"></view>
        <text class="pick-label">用车\n城市</text>
        <text class="pick-value">{{startCity}}</text>
        <text class="chev">›</text>
      </view>
      <picker mode="date" value="{{departDate}}" start="{{minDate}}" bindchange="onDateChange">
        <view class="pick-card">
          <view class="cal"></view>
          <text class="pick-label">用车日期</text>
          <text class="pick-value">{{departDateLabel}}</text>
          <text class="chev">›</text>
        </view>
      </picker>
    </view>
    <view class="chips">
      <view
        class="chip {{startCity === item.name ? 'chip--on' : ''}}"
        wx:for="{{cities}}"
        wx:key="id"
        data-name="{{item.name}}"
        bindtap="onCityChip"
      >
        <text>{{item.name}}</text>
        <text wx:if="{{item.hot}}" class="chip-hot">🔥</text>
      </view>
    </view>
  </view>

  <block wx:if="{{mode === 'line'}}">
  <view class="type-block">
    <view class="type-row">
      <view class="type-btn type-btn--on">
        <view class="dot dot--on"></view>
        <text>整车包车</text>
      </view>
      <view class="type-btn" bindtap="onCarpoolTap">
        <view class="dot"></view>
        <text>座位拼车</text>
      </view>
    </view>
    <text class="type-hint">一车独享，可自主出价，上门接送</text>
  </view>

  <view class="sort-block">
    <view class="sort-pill sort-pill--on" bindtap="onSortTap">
      <text>{{sortLabel}}</text>
      <text class="caret">▾</text>
    </view>
    <view class="sort-pill" bindtap="onCarModelTap">
      <text>车型筛选</text>
      <text class="caret caret--muted">▾</text>
    </view>
    <view class="sort-pill {{tripType ? 'sort-pill--on' : ''}}" bindtap="onTripTap">
      <text>{{tripLabel}}</text>
      <text class="caret {{tripType ? '' : 'caret--muted'}}">▾</text>
    </view>
  </view>

  <view class="banner" wx:if="{{banner}}" bindtap="onBannerTap">
    <view class="banner-tag">限时特惠</view>
    <text class="banner-title">{{banner.title}}</text>
    <view class="banner-btn">立即抢购</view>
  </view>

  <view
    class="route-card"
    id="route-{{item.id}}"
    wx:for="{{list}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="onCardTap"
  >
    <view class="thumb">
      <image class="thumb-img" src="{{item.coverImg}}" mode="aspectFill" />
      <view class="badge" wx:if="{{item.estimatedDuration}}">{{item.estimatedDuration}}</view>
      <view class="heart" catchtap="onFavTap" data-id="{{item.id}}">
        <text class="heart-icon {{item.fav ? 'heart-icon--on' : ''}}">♥</text>
      </view>
    </view>
    <view class="info">
      <text class="title">{{item.routeName}}</text>
      <view class="meta">
        <text wx:if="{{item.score != null}}" class="star">★ {{item.score}}</text>
        <text wx:if="{{item.score != null}}" class="sep">|</text>
        <text>已售 {{item.soldCount}} 单</text>
      </view>
      <text class="sub" wx:for="{{item.descLines}}" wx:for-item="line" wx:key="*this">{{line}}</text>
      <view class="price-row">
        <text class="price" wx:if="{{item.referencePrice != null}}">¥{{item.referencePrice}}</text>
        <text class="qi">起</text>
      </view>
      <text class="bid">自主出价 司机抢单</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && total === 0}}">暂无符合条件的线路</view>
  <view class="pad"></view>
  </block>

  <block wx:else>
    <view class="hour-list">
      <view
        class="pkg-card"
        wx:for="{{hourPackages}}"
        wx:key="tag"
        bindtap="onHourPackageTap"
      >
        <view class="pkg-main">
          <view class="pkg-head">
            <text class="pkg-tag">{{item.tag}}</text>
            <text class="pkg-title">{{item.title}}</text>
          </view>
          <text class="pkg-desc">{{item.desc}}</text>
          <view class="pkg-price-row">
            <text class="pkg-price">{{item.price}}</text>
            <text class="qi">起</text>
          </view>
        </view>
        <view class="pkg-arrow">›</view>
      </view>

      <view class="svc-card" bindtap="onToggleService">
        <view class="svc-left">
          <text class="svc-dot">i</text>
          <text class="svc-label">服务说明</text>
        </view>
        <text class="svc-chev {{showServiceNote ? 'svc-chev--open' : ''}}">▾</text>
      </view>
      <view class="svc-note" wx:if="{{showServiceNote}}">含油费 + 司机服务费，过路费停车费实报实销，服务范围仅限市区及近郊</view>

      <view class="hot-head">
        <text class="hot-title">热门线路推荐</text>
        <text class="hot-sub">性价比更高</text>
      </view>
      <view
        class="hot-card"
        wx:for="{{hotRoutes}}"
        wx:key="title"
        bindtap="onHotPickTap"
      >
        <view class="hot-thumb">
          <image class="hot-img" src="{{item.cover}}" mode="aspectFill" />
          <text class="hot-save">{{item.save}}</text>
        </view>
        <view class="hot-info">
          <text class="hot-name">{{item.title}}</text>
          <view class="meta">
            <text class="star">★ {{item.score}}</text>
            <text>{{item.sold}}</text>
          </view>
          <view class="hot-foot">
            <view class="price-row">
              <text class="price">{{item.price}}</text>
              <text class="old-price">{{item.oldPrice}}</text>
            </view>
            <text class="hot-cta">选ta</text>
          </view>
        </view>
      </view>
    </view>
    <view class="pad"></view>
  </block>
</view>

<view class="mask" wx:if="{{showSortSheet || showTripSheet || showCitySheet}}" bindtap="onCloseSheet"></view>
<view class="sheet" wx:if="{{showSortSheet}}">
  <view class="sheet-item {{sort === 'recommend' ? 'sheet-item--on' : ''}}" data-sort="recommend" bindtap="onSortPick">推荐排序</view>
  <view class="sheet-item {{sort === 'priceAsc' ? 'sheet-item--on' : ''}}" data-sort="priceAsc" bindtap="onSortPick">价格从低到高</view>
  <view class="sheet-item {{sort === 'soldDesc' ? 'sheet-item--on' : ''}}" data-sort="soldDesc" bindtap="onSortPick">销量优先</view>
</view>
<view class="sheet" wx:if="{{showTripSheet}}">
  <view class="sheet-item {{!tripType ? 'sheet-item--on' : ''}}" data-trip="" bindtap="onTripPick">不限</view>
  <view class="sheet-item {{tripType === '半日游' ? 'sheet-item--on' : ''}}" data-trip="半日游" bindtap="onTripPick">半日游</view>
  <view class="sheet-item {{tripType === '1日游' ? 'sheet-item--on' : ''}}" data-trip="1日游" bindtap="onTripPick">1日游</view>
  <view class="sheet-item {{tripType === '2日游' ? 'sheet-item--on' : ''}}" data-trip="2日游" bindtap="onTripPick">2日游</view>
</view>
<view class="sheet" wx:if="{{showCitySheet}}">
  <view
    class="sheet-item {{startCity === item.name ? 'sheet-item--on' : ''}}"
    wx:for="{{cities}}"
    wx:key="id"
    data-name="{{item.name}}"
    bindtap="onCityChip"
  >{{item.name}}</view>
</view>
