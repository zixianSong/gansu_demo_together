.detail-page {
  padding-bottom: var(--save-bar-space);
}

.status-box {
  background-color: var(--color-white);
  padding: var(--space-xl) var(--page-padding-horizontal);
  text-align: center;
}

.status-title {
  font-size: var(--font-size-extra-large);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}

.status-desc {
  display: block;
  margin-top: var(--space-sm);
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
}

.info-card {
  padding: var(--space-lg);
}

.cat {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
}

.title,
.block-title {
  display: block;
  margin: var(--space-sm) 0 var(--space-md);
  font-size: var(--font-size-heading);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}

.kv {
  display: flex;
  justify-content: space-between;
  gap: var(--space-lg);
  margin-top: var(--space-sm);
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
}

.kv-v {
  color: var(--text-primary);
  text-align: right;
  flex: 1;
}

.row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-sm);
}

.link {
  color: var(--color-primary-blue);
}

.strong {
  font-weight: var(--font-weight-bold);
}

.voucher {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-box {
  width: var(--qr-size);
  height: var(--qr-size);
  border: var(--hairline) solid var(--fill-base);
  border-radius: var(--radius-medium);
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr {
  width: 80%;
  height: 80%;
  background-color: var(--text-primary);
}

.qr-img {
  width: 100%;
  height: 100%;
}

.voucher-hint {
  margin-top: var(--space-md);
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
}

.voucher-btn {
  width: 100%;
  margin-top: var(--space-lg);
  border-radius: var(--radius-full);
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--color-white);
  border-top: var(--hairline) solid var(--fill-base);
  padding: var(--space-md) var(--page-padding-horizontal);
  display: flex;
  gap: var(--space-md);
}

.bottom-btn {
  flex: 1;
  width: auto;
  border-radius: var(--radius-full);
}
