<view class="page-container detail-page">
  <view class="status-box">
    <text class="status-title">{{order.statusText}}</text>
    <text class="status-desc">{{statusDesc}}</text>
  </view>

  <view class="card info-card">
    <text class="cat">{{order.category}}</text>
    <text class="title">{{order.title}}</text>
    <view class="kv"><text>有效期</text><text class="kv-v">{{order.validDate}}</text></view>
    <view class="kv"><text>份数</text><text class="kv-v">{{order.count}}</text></view>
    <view class="kv"><text>使用方式</text><text class="kv-v">{{order.usage}}</text></view>
  </view>

  <view class="card info-card">
    <text class="block-title">出行人信息</text>
    <view class="kv"><text>姓名</text><text class="kv-v">{{traveler.name}}</text></view>
    <view class="kv"><text>证件类型</text><text class="kv-v">{{traveler.idTypeText}}</text></view>
    <view class="kv"><text>证件号码</text><text class="kv-v">{{traveler.idNumber}}</text></view>
    <view class="kv"><text>联系方式</text><text class="kv-v">{{traveler.phone}}</text></view>
  </view>

  <view wx:if="{{showVoucher}}" class="card info-card voucher">
    <text class="block-title">使用凭证</text>
    <view class="qr-box">
      <image wx:if="{{voucher.qrcodeImage}}" class="qr-img" src="{{voucher.qrcodeImage}}" mode="aspectFit" />
      <view wx:else class="qr"></view>
    </view>
    <text class="voucher-hint">已核销 {{usedCount}} / {{totalCount}} 次</text>
    <button class="btn-primary voucher-btn" bindtap="onShowVoucher">使用凭证</button>
  </view>

  <view class="card info-card">
    <text class="block-title">订单信息</text>
    <view class="kv">
      <text>订单号</text>
      <view class="kv-v row">
        <text>{{order.orderNo}}</text>
        <text class="link" bindtap="onCopy">复制</text>
      </view>
    </view>
    <view class="kv">
      <text>在线支付金额</text>
      <view class="kv-v row">
        <text class="strong">¥{{order.price}}</text>
        <text class="link" bindtap="onFee">费用明细</text>
      </view>
    </view>
    <view class="kv"><text>交易快照</text><text class="kv-v">{{snapshotNote}}</text></view>
    <view class="kv"><text>退订规则</text><text class="kv-v">{{refundRule}}</text></view>
  </view>

  <view class="bottom-bar">
    <button wx:if="{{showCancel}}" class="btn-secondary bottom-btn" bindtap="onCancel">取消订单</button>
    <button class="btn-primary bottom-btn" bindtap="onRebook">再次预订</button>
  </view>
</view>
