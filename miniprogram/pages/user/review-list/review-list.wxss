.tabs {
  display: flex;
  justify-content: center;
  gap: var(--space-xl);
  background-color: var(--color-white);
  border-bottom: var(--hairline) solid var(--fill-base);
}

.tab {
  padding: var(--space-md) 0;
  font-size: var(--font-size-body);
  color: var(--text-secondary);
  border-bottom: var(--space-xs) solid transparent;
}

.tab--active {
  color: var(--text-primary);
  font-weight: var(--font-weight-bold);
  border-bottom-color: var(--color-primary-blue);
}

.list {
  padding-top: var(--space-sm);
}

.item {
  padding: var(--space-lg);
}

.top,
.body,
.bottom,
.actions {
  display: flex;
}

.top,
.bottom {
  justify-content: space-between;
  align-items: center;
}

.body {
  margin: var(--space-md) 0;
  justify-content: space-between;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.title {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
}

.cat,
.status,
.meta {
  font-size: var(--font-size-caption);
  color: var(--text-annotation);
}

.score {
  font-size: var(--font-size-heading);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary-yellow);
}

.price-wrap {
  margin-left: var(--space-lg);
  text-align: right;
}

.price {
  font-family: var(--font-family-number);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-bold);
  color: var(--text-secondary);
}

.content {
  font-size: var(--font-size-body);
  color: var(--text-secondary);
}

.actions {
  justify-content: flex-end;
  align-items: center;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: var(--space-sm);
}

.actions button.action-btn {
  margin: 0;
  width: auto;
  min-width: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  font-size: var(--font-size-caption);
  border-radius: var(--radius-full);
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.actions button.action-btn::after {
  border: none;
}

.action-btn--ghost {
  background-color: var(--color-white);
  color: var(--text-secondary);
  border: 2rpx solid #e5e5e5;
}

.action-btn--primary {
  background-color: var(--color-primary-blue);
  color: var(--color-white);
  border: 2rpx solid var(--color-primary-blue);
}

.hint {
  padding: var(--space-xl) 0;
  text-align: center;
  font-size: var(--font-size-tag);
  color: var(--text-annotation);
}

.link {
  color: var(--color-primary-blue);
}
