<view class="page-container profile-page">
  <view class="form-card">
    <view class="form-row">
      <text class="label">标题</text>
      <input class="value-input" value="{{formTitle}}" placeholder="请输入标题" maxlength="80" bindinput="onTitle" />
    </view>
    <view class="form-block">
      <text class="label">内容</text>
      <textarea class="bio" value="{{formContent}}" maxlength="2000" placeholder="请描述问题" bindinput="onContent" />
    </view>
  </view>
  <view class="save-bar">
    <button class="btn-primary save-btn" bindtap="onSubmit">提交</button>
  </view>
</view>
