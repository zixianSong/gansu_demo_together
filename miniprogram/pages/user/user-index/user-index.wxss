.mine-page {
  padding-bottom: var(--space-xl);
}

.user-header {
  background-color: var(--color-primary-blue);
  color: var(--text-on-primary);
  padding: var(--space-xl) var(--page-padding-horizontal);
}

.user-row {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  width: var(--avatar-size);
  height: var(--avatar-size);
  border-radius: var(--radius-full);
  background-color: var(--fill-on-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar {
  width: var(--avatar-size);
  height: var(--avatar-size);
}

.avatar-placeholder {
  color: var(--text-on-primary);
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-medium);
}

.user-meta {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-lg);
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: var(--font-size-heading);
  font-weight: var(--font-weight-bold);
  color: var(--text-on-primary);
}

.user-hint {
  margin-top: var(--space-xs);
  font-size: var(--font-size-caption);
  color: var(--text-on-primary-muted);
}

.profile-link {
  flex-shrink: 0;
  margin-left: var(--space-sm);
  padding: var(--space-xs) var(--space-md);
  background-color: var(--fill-on-primary-strong);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  font-size: var(--font-size-caption);
  color: var(--text-on-primary);
}

.user-extra {
  margin-top: var(--space-xl);
  display: flex;
  gap: var(--space-xl);
  font-size: var(--font-size-caption);
  color: var(--text-on-primary-muted);
}

.extra-strong {
  color: var(--text-on-primary);
}

.order-card {
  margin-top: calc(0px - var(--header-overlap));
  padding: var(--space-lg);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-lg);
}

.order-title {
  font-size: var(--font-size-heading);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}

.order-all {
  display: flex;
  align-items: center;
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
}

.order-grid {
  display: flex;
}

.order-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-sm) 0;
}

.order-icon {
  color: var(--color-primary-blue);
  font-size: var(--font-size-title);
}

.order-label {
  margin-top: var(--space-sm);
  font-size: var(--font-size-tag);
  color: var(--text-secondary);
}

.menu-card {
  margin: var(--space-lg) var(--page-padding-horizontal) 0;
  background-color: var(--color-white);
  border-radius: var(--radius-large);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.menu-item {
  padding: var(--space-md) var(--space-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: var(--hairline) solid var(--fill-base);
}

.menu-item--last {
  border-bottom: none;
}

.menu-title {
  color: var(--text-primary);
  font-size: var(--font-size-body);
}

.arrow {
  margin-left: var(--space-xs);
  font-size: var(--font-size-heading);
  line-height: 1;
}

.muted {
  color: var(--text-annotation);
}
