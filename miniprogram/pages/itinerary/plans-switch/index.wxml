<view class="page">
  <view class="card">
    <view class="card__title">切换方案确认</view>
    <view>确定要切换到「{{name}}」吗？</view>
    <view class="sec">冲突摘要（只标记，不自动改）</view>
    <view class="meta" wx:for="{{duplicates}}" wx:key="poiId">重复：{{item.name}}</view>
    <view class="meta" wx:for="{{conflicts}}" wx:key="reason">{{item.name}} · {{item.reason}}</view>
    <view class="meta" wx:if="{{!duplicates.length && !conflicts.length}}">未检测到重复或时空冲突</view>
    <view class="btn-row">
      <view class="btn btn-ghost" bindtap="back">取消</view>
      <view class="btn btn-pri" bindtap="confirm">确认切换</view>
    </view>
  </view>
</view>
