<view class="page">
  <itinerary-chrome active="overview" bind:restored="load" />

  <view class="periods">
    <view class="period {{slot === 'morning' ? 'is-on' : ''}}" data-slot="morning" bindtap="setSlot">上午</view>
    <view class="period {{slot === 'noon' ? 'is-on' : ''}}" data-slot="noon" bindtap="setSlot">中午</view>
    <view class="period {{slot === 'afternoon' ? 'is-on' : ''}}" data-slot="afternoon" bindtap="setSlot">下午</view>
    <view class="period {{slot === 'evening' ? 'is-on' : ''}}" data-slot="evening" bindtap="setSlot">晚上</view>
  </view>

  <view class="empty" wx:if="{{!rows.length}}">该时段暂无行程</view>

  <view class="board">
    <view class="day" wx:for="{{rows}}" wx:key="id">
      <view class="day__label">
        <view class="day__n">D{{item.dayNumber}}</view>
        <view class="day__w">{{item.weekday}}</view>
      </view>
      <scroll-view class="track" scroll-x enhanced show-scrollbar="{{false}}">
        <view
          class="cell cell--{{node.kind}}"
          wx:for="{{item.nodes}}"
          wx:for-item="node"
          wx:key="id"
          data-id="{{node.poiId}}"
          bindtap="openPoi"
        >
          <view class="cell__time" wx:if="{{node.timeLabel}}">{{node.timeLabel}}</view>
          <view class="cell__name">{{node.name}}</view>
          <view class="cell__meta">{{node.type}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="hotel" wx:if="{{focus}}">
    <view class="hotel__ico">{{focus.type || '行程'}}</view>
    <view class="hotel__body">
      <view class="hotel__title">{{focus.name}}</view>
      <view class="hotel__meta">{{focus.poiAddress || '点击查看详情'}}</view>
    </view>
    <view class="hotel__go" data-id="{{focus.poiId}}" bindtap="openPoi">详情</view>
  </view>
</view>
