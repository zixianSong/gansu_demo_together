page {
  background: #fafaf9;
}
.page {
  min-height: 100vh;
  background: #fafaf9;
  padding-bottom: 120px;
}
.day-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 20px 0;
  background: #fff;
}
.day-switch__btn {
  width: 40px;
  height: 40px;
  line-height: 40px;
  text-align: center;
  border-radius: 16px;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  color: #a8a29e;
  font-size: 20px;
}
.day-switch__center {
  flex: 1;
  text-align: center;
}
.day-switch__date {
  font-size: 22px;
  font-weight: 800;
}
.day-switch__meta {
  font-size: 12px;
  color: #a8a29e;
}
.weather {
  margin: 16px 20px 8px;
  padding: 16px 20px;
  background: #fff;
  border-radius: 24px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  gap: 16px;
}
.weather__pin {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.weather__temp {
  display: flex;
  align-items: flex-end;
  color: #292524;
}
.weather__num {
  font-size: 32px;
  font-weight: 800;
  line-height: 1;
  margin-right: 4px;
}
.weather__desc {
  margin-top: 4px;
  font-size: 13px;
  color: #78716c;
}
.empty {
  padding: 32px 16px;
  text-align: center;
  color: #a8a29e;
}
.schedule {
  padding: 8px 20px 24px;
}
.slot-time {
  font-size: 12px;
  font-weight: 600;
  color: #a8a29e;
  margin: 12px 0 8px;
}
.event {
  background: #fff;
  border-radius: 16px;
  padding: 14px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}
.event--transit {
  border-left: 4px solid #14b8a6;
}
.event--hotel {
  background: #fff8e7;
}
.event--spot {
  overflow: hidden;
}
.event__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}
.event__type {
  font-size: 12px;
  font-weight: 600;
  color: #78716c;
}
.badge {
  font-size: 11px;
  color: #15803d;
  background: #dcfce7;
  padding: 2px 8px;
  border-radius: 999px;
}
.cover {
  height: 88px;
  border-radius: 12px;
  background: linear-gradient(135deg, #1d4ed8, #0f172a);
  color: #fff;
  display: flex;
  align-items: flex-end;
  padding: 10px 12px;
  font-size: 18px;
  font-weight: 700;
  margin-bottom: 8px;
}
.event__title {
  font-size: 16px;
  font-weight: 700;
}
.event__meta {
  margin-top: 4px;
  font-size: 12px;
  color: #a8a29e;
}
.suggest {
  position: fixed;
  left: 12px;
  right: 12px;
  bottom: calc(12px + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 20px;
  padding: 14px;
  box-shadow: 0 8px 28px rgba(15, 23, 42, 0.16);
}
.suggest__head {
  display: flex;
  gap: 10px;
}
.suggest__mark {
  color: #2563eb;
  font-size: 18px;
}
.suggest__title {
  font-size: 15px;
  font-weight: 700;
}
.suggest__text {
  margin-top: 4px;
  font-size: 12px;
  color: #78716c;
  line-height: 1.5;
}
.suggest__actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;
}
.btn-apply,
.btn-ignore {
  flex: 1;
  height: 40px;
  line-height: 40px;
  text-align: center;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
}
.btn-apply {
  background: #2563eb;
  color: #fff;
}
.btn-ignore {
  background: #f3f4f6;
  color: #374151;
}
