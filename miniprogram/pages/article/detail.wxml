<view class="page" wx:if="{{!loading}}">

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">

    <view class="article-head">

      <text class="title">{{article.title}}</text>



      <view class="head-actions">

        <view

          class="mention-chip"

          wx:if="{{article.hasRelatedPois}}"

          bindtap="onOpenPoiSheet"

        >

          <image class="mention-icon" src="/static/images/icon/location-pin.svg" mode="aspectFit" />

          <text class="mention-text">提及地点</text>

        </view>

        <view

          class="mention-chip mention-chip-route"

          wx:if="{{article.hasRelatedRoutes}}"

          bindtap="onOpenRouteSheet"

        >

          <text class="mention-text">提及线路</text>

        </view>

      </view>



      <view class="meta" wx:if="{{article.author || publishedText}}">

        <text class="meta-author" wx:if="{{article.author}}">{{article.author}}</text>

        <text class="meta-dot" wx:if="{{article.author && publishedText}}">·</text>

        <text class="meta-time" wx:if="{{publishedText}}">{{publishedText}}</text>

        <text class="meta-type">{{contentTypeLabel}}</text>

      </view>



      <view class="tags" wx:if="{{article.tags && article.tags.length}}">

        <text class="tag" wx:for="{{article.tags}}" wx:key="*this">{{item}}</text>

      </view>

    </view>



    <view class="content-card">

      <rich-text class="content" nodes="{{contentNodes}}"></rich-text>

    </view>



    <view class="related-block" wx:if="{{article.hasRelatedPois && previewPoi}}">

      <view

        class="preview-card"

        data-id="{{previewPoi.poiId}}"

        bindtap="onPreviewPoiTap"

      >

        <image

          class="preview-cover"

          src="{{previewPoi.coverUrl || '/static/images/icon/image.svg'}}"

          mode="aspectFill"

        />

        <view class="preview-body">

          <text class="preview-name text-ellipsis">{{previewPoi.name}}</text>

          <text class="preview-desc text-ellipsis">{{previewPoi.subtitle}}</text>

          <text class="preview-tags">{{previewPoi.categoryLabel}}</text>

        </view>

      </view>

      <view class="view-all" bindtap="onOpenPoiSheet">

        <text class="view-all-text">查看全部  ></text>

      </view>

    </view>



    <view class="safe-bottom"></view>

  </scroll-view>



  <!-- 提及地点弹层 2:191 -->

  <view class="sheet-mask" wx:if="{{showPoiSheet}}" bindtap="onCloseSheets" catchtouchmove="noop"></view>

  <view class="sheet {{showPoiSheet ? 'sheet-show' : ''}}">

    <view class="sheet-head">

      <text class="sheet-title">{{poiSheetTitle}}</text>

      <view class="sheet-close-btn" bindtap="onCloseSheets">

        <image class="sheet-close-icon" src="/static/images/icon/close-line.svg" mode="aspectFit" />

      </view>

    </view>

    <scroll-view class="sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}">

      <view class="empty" wx:if="{{!relatedPois.length}}">

        <text class="empty-text">暂无关联地点</text>

      </view>

      <view

        class="poi-card"

        wx:for="{{relatedPois}}"

        wx:key="poiId"

        data-id="{{item.poiId}}"

        bindtap="onPoiTap"

      >

        <image class="poi-cover" src="{{item.coverUrl || '/static/images/icon/image.svg'}}" mode="aspectFill" />

        <view class="poi-body">

          <text class="poi-name text-ellipsis">{{item.name}}</text>

          <text class="poi-desc text-ellipsis">{{item.subtitle}}</text>

          <text class="poi-tags">{{item.categoryLabel}}</text>

        </view>

      </view>

      <view class="sheet-safe"></view>

    </scroll-view>

  </view>



  <!-- 提及线路弹层 -->

  <view class="sheet-mask" wx:if="{{showRouteSheet}}" bindtap="onCloseSheets" catchtouchmove="noop"></view>

  <view class="sheet {{showRouteSheet ? 'sheet-show' : ''}}">

    <view class="sheet-head">

      <text class="sheet-title">提及线路</text>

      <view class="sheet-close-btn" bindtap="onCloseSheets">

        <image class="sheet-close-icon" src="/static/images/icon/close-line.svg" mode="aspectFit" />

      </view>

    </view>

    <scroll-view class="sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}">

      <view class="empty" wx:if="{{!relatedRoutes.length}}">

        <text class="empty-text">暂无关联线路</text>

      </view>

      <view

        class="poi-card"

        wx:for="{{relatedRoutes}}"

        wx:key="routeId"

        data-id="{{item.routeId}}"

        bindtap="onRouteTap"

      >

        <image class="poi-cover" src="{{item.coverUrl || '/static/images/icon/image.svg'}}" mode="aspectFill" />

        <view class="poi-body">

          <text class="poi-name text-ellipsis">{{item.name}}</text>

          <text class="poi-desc text-ellipsis">{{item.subtitle || ''}}{{item.subtitle && item.daysCount ? ' · ' : ''}}{{item.daysCount ? item.daysCount + '天' : ''}}</text>

          <text class="poi-tags">线路</text>

        </view>

      </view>

      <view class="sheet-safe"></view>

    </scroll-view>

  </view>

</view>



<view class="loading" wx:else>

  <text class="loading-text">加载中...</text>

</view>

