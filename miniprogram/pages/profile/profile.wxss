.profile-page {
  padding-bottom: var(--save-bar-space);
}

.avatar-edit {
  background-color: var(--color-white);
  padding: var(--space-xl) 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  position: relative;
  width: var(--avatar-xl);
  height: var(--avatar-xl);
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: var(--avatar-xl);
  height: var(--avatar-xl);
  border-radius: var(--radius-full);
  background-color: var(--fill-base);
}

.camera {
  position: absolute;
  right: 0;
  bottom: 0;
  width: var(--icon-size-base);
  height: var(--icon-size-base);
  border-radius: var(--radius-full);
  background-color: var(--color-primary-blue);
  color: var(--text-on-primary);
  font-size: var(--font-size-tag);
  display: flex;
  align-items: center;
  justify-content: center;
}

.change-text {
  margin-top: var(--space-md);
  font-size: var(--font-size-caption);
  color: var(--color-primary-blue);
}

.form-card {
  margin-top: var(--space-md);
  background-color: var(--color-white);
}

.form-row {
  padding: var(--space-md) var(--page-padding-horizontal);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: var(--hairline) solid var(--fill-base);
}

.label {
  font-size: var(--font-size-body);
  color: var(--text-secondary);
  width: var(--label-width);
  flex-shrink: 0;
}

.value-input {
  flex: 1;
  text-align: right;
  font-size: var(--font-size-body);
  color: var(--text-primary);
}

.value-wrap {
  display: flex;
  align-items: center;
}

.value {
  font-size: var(--font-size-body);
  color: var(--text-secondary);
}

.arrow {
  margin-left: var(--space-xs);
  color: var(--text-annotation);
  font-size: var(--font-size-heading);
}

.form-block {
  padding: var(--space-md) var(--page-padding-horizontal);
}

.bio {
  margin-top: var(--space-sm);
  width: 100%;
  min-height: var(--textarea-min);
  padding: var(--space-md);
  box-sizing: border-box;
  background-color: var(--fill-base);
  border-radius: var(--radius-medium);
  font-size: var(--font-size-body);
  color: var(--text-primary);
}

.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--color-white);
  border-top: var(--hairline) solid var(--fill-base);
  padding: var(--space-md) var(--page-padding-horizontal);
}

.save-btn {
  width: 100%;
  border-radius: var(--radius-full);
}
