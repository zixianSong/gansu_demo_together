page {
  --charter-bg: #f3f4f6;
  --charter-ink: #1d1d1f;
  --charter-chip: #e8f4ff;
  --charter-chip-t: #125fcc;
  --charter-muted: #9ca3af;
  --charter-hint: #6b7280;
  --charter-gray: #374151;
  --charter-fill: #f9fafb;
  --charter-text4: #4b5563;
  background-color: var(--charter-bg);
}

.page {
  min-height: 100vh;
  background: var(--charter-bg);
  box-sizing: border-box;
}

.mode-row,
.filter-block,
.type-block,
.sort-block {
  background: var(--color-white);
  padding: 0 32rpx;
}

.mode-row {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
}

.mode-card {
  flex: 1;
  height: 132rpx;
  border-radius: 32rpx;
  background: var(--charter-bg);
  position: relative;
}

.mode-card--on {
  background: var(--color-primary-blue);
  box-shadow: 0 8rpx 32rpx rgba(22, 119, 255, 0.28);
}

.mode-title {
  position: absolute;
  left: 32rpx;
  top: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--charter-text4);
}

.mode-title--on {
  color: var(--color-white);
}

.mode-sub {
  position: absolute;
  left: 32rpx;
  top: 76rpx;
  font-size: 24rpx;
  color: var(--charter-muted);
}

.mode-sub--on {
  color: rgba(255, 255, 255, 0.9);
}

.pick-row {
  display: flex;
  gap: 24rpx;
}

.pick-card {
  flex: 1;
  height: 128rpx;
  background: var(--charter-fill);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 16rpx;
}

.pick-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--charter-gray);
  line-height: 40rpx;
}

.pick-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--charter-ink);
}

.chev {
  margin-left: auto;
  color: #d1d5db;
  font-size: 32rpx;
}

.pin,
.cal {
  width: 24rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: var(--color-primary-blue);
  flex-shrink: 0;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx 0 24rpx;
}

.chip {
  height: 58rpx;
  padding: 0 28rpx;
  border-radius: 9999rpx;
  background: var(--charter-bg);
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--charter-text4);
}

.chip--on {
  background: var(--charter-chip);
  border: 1rpx solid #a3d3ff;
  color: var(--charter-chip-t);
}

.chip-hot {
  margin-left: 8rpx;
  color: #47a7ff;
}

.type-row {
  display: flex;
  gap: 24rpx;
  padding-top: 8rpx;
}

.type-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--charter-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--charter-text4);
}

.type-btn--on {
  background: var(--color-primary-blue);
  color: var(--color-white);
  font-weight: 600;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 9999rpx;
  background: var(--charter-muted);
}

.dot--on {
  background: var(--color-white);
}

.type-hint {
  display: block;
  padding: 16rpx 0 24rpx;
  font-size: 24rpx;
  color: var(--charter-hint);
}

.sort-block {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--charter-fill);
}

.sort-pill {
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 9999rpx;
  background: var(--charter-bg);
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--charter-text4);
}

.sort-pill--on {
  background: var(--charter-chip);
  color: var(--charter-chip-t);
}

.caret {
  font-size: 20rpx;
}

.caret--muted {
  color: var(--charter-text4);
}

.banner {
  margin: 24rpx 34rpx 0;
  height: 104rpx;
  border-radius: 32rpx;
  background: linear-gradient(90deg, #1677ff 0%, #47a7ff 100%);
  box-shadow: 0 16rpx 48rpx rgba(22, 119, 255, 0.24);
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  gap: 16rpx;
}

.banner-tag {
  width: 120rpx;
  height: 40rpx;
  background: var(--color-white);
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.banner-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-white);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner-btn {
  width: 144rpx;
  height: 56rpx;
  background: var(--color-white);
  border-radius: 9999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.route-card {
  margin: 24rpx 34rpx 0;
  background: var(--color-white);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  display: flex;
  min-height: 280rpx;
}

.thumb {
  width: 280rpx;
  height: 280rpx;
  flex-shrink: 0;
  position: relative;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.badge {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  background: rgba(0, 0, 0, 0.6);
  color: var(--color-white);
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.heart {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.heart-icon {
  color: #9ca3af;
  font-size: 28rpx;
}

.heart-icon--on {
  color: var(--color-danger);
}

.info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
  color: var(--charter-ink);
}

.meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--charter-hint);
  margin-top: 8rpx;
}

.star {
  color: #f59e0b;
  font-weight: 500;
}

.sep {
  color: #d1d5db;
}

.sub {
  font-size: 24rpx;
  color: var(--charter-muted);
  margin-top: 4rpx;
}

.price-row {
  margin-top: auto;
  display: flex;
  align-items: baseline;
}

.price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary-blue);
  font-family: var(--font-family-number);
}

.qi {
  font-size: 24rpx;
  color: var(--charter-muted);
  margin-left: 8rpx;
}

.bid {
  font-size: 22rpx;
  color: #47a7ff;
  margin-top: 4rpx;
}

.empty {
  margin: 80rpx 32rpx;
  text-align: center;
  color: var(--charter-hint);
  font-size: 28rpx;
}

.pad {
  height: 48rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--overlay-mask);
  z-index: 10;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-white);
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  z-index: 11;
}

.sheet-item {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--text-secondary);
}

.sheet-item--on {
  color: var(--color-primary-blue);
  font-weight: 600;
}
