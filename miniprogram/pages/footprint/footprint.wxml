<view class="page-container">
  <view class="stats">
    <view class="stat">
      <text class="stat-num">{{stats.poiCount}}</text>
      <text class="stat-label">浏览景点数</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{stats.cityCount}}</text>
      <text class="stat-label">到访城市数</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{stats.travelDays}}</text>
      <text class="stat-label">旅行天数</text>
    </view>
  </view>

  <view class="group" wx:for="{{groups}}" wx:key="date">
    <view class="date-line">
      <view class="line"></view>
      <text class="date">{{item.date}}</text>
      <view class="line"></view>
    </view>
    <view class="spot" wx:for="{{item.items}}" wx:for-item="spot" wx:key="title" data-id="{{spot.poiId}}" bindtap="onOpen">
      <view class="time-col">
        <text class="time">{{spot.time}}</text>
        <view class="dot"></view>
      </view>
      <image class="cover" src="{{spot.cover}}" mode="aspectFill" />
      <view class="spot-info">
        <text class="spot-title">{{spot.title}}</text>
        <view class="tags">
          <text class="tag" wx:for="{{spot.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
        <text class="addr">{{spot.address}}</text>
      </view>
    </view>
  </view>
</view>
