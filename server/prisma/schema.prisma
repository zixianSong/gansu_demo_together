generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Destination {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name           String    @db.VarChar(64)
  coverUrl       String?   @map("cover_url") @db.VarChar(512)
  intro          String?   @db.Text
  transportGuide String?   @map("transport_guide") @db.Text
  status         Int       @default(1) @db.UnsignedTinyInt
  sortWeight     Int       @default(0) @map("sort_weight")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  hotConfigs     HomeHotDestination[]
  pois           Poi[]
  routeTemplates RouteTemplate[]

  @@map("destination")
}

model RouteTemplate {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  destinationId BigInt?   @map("destination_id") @db.UnsignedBigInt
  name          String    @db.VarChar(128)
  coverUrl      String?   @map("cover_url") @db.VarChar(512)
  subtitle      String?   @db.VarChar(255)
  intro         String?   @db.Text
  daysCount     Int       @map("days_count")
  status        Int       @default(1) @db.UnsignedTinyInt
  sortWeight    Int       @default(0) @map("sort_weight")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  destination Destination?     @relation(fields: [destinationId], references: [id])
  hotConfigs  HomeHotRoute[]
  articles    ArticleRoute[]

  @@map("route_template")
}

model Poi {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  destinationId  BigInt?   @map("destination_id") @db.UnsignedBigInt
  category       String    @db.VarChar(32)
  poiSubtype     String    @map("poi_subtype") @db.VarChar(32)
  name           String    @db.VarChar(128)
  coverUrl       String?   @map("cover_url") @db.VarChar(512)
  imagesJson     Json?     @map("images_json")
  tagsJson       Json?     @map("tags_json")
  address        String?   @db.VarChar(255)
  city           String?   @db.VarChar(50)
  openTime       String?   @map("open_time") @db.VarChar(128)
  price          Decimal?  @db.Decimal(10, 2)
  priceNote      String?   @map("price_note") @db.VarChar(128)
  intro          String?   @db.Text
  suggestDuration String?  @map("suggest_duration") @db.VarChar(64)
  lat            Decimal?  @db.Decimal(10, 7)
  lng            Decimal?  @db.Decimal(10, 7)
  bookingAppid   String?   @map("booking_appid") @db.VarChar(64)
  bookingPath    String?   @map("booking_path") @db.VarChar(255)
  bookingUrl     String?   @map("booking_url") @db.VarChar(512)
  grade          String?   @db.VarChar(16)
  cuisineType    String?   @map("cuisine_type") @db.VarChar(64)
  avgCost        Decimal?  @map("avg_cost") @db.Decimal(10, 2)
  rating         Decimal?  @db.Decimal(2, 1)
  status         Int       @default(1) @db.UnsignedTinyInt
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  destination Destination?  @relation(fields: [destinationId], references: [id])
  articles    ArticlePoi[]
  footprints  Footprint[]

  @@map("poi")
}

model Article {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title       String    @db.VarChar(200)
  coverUrl    String?   @map("cover_url") @db.VarChar(512)
  contentType String    @map("content_type") @db.VarChar(32)
  contentHtml String?   @map("content_html") @db.MediumText
  wechatUrl   String?   @map("wechat_url") @db.VarChar(512)
  wechatMsgId String?   @unique @map("wechat_msg_id") @db.VarChar(64)
  tagsJson    Json?     @map("tags_json")
  priceLabel  String?   @map("price_label") @db.VarChar(32)
  bookingPath String?   @map("booking_path") @db.VarChar(255)
  author      String?   @db.VarChar(64)
  publishedAt DateTime? @map("published_at")
  status      Int       @default(1) @db.UnsignedTinyInt
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  pois   ArticlePoi[]
  routes ArticleRoute[]

  @@map("article")
}

model ArticlePoi {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  articleId BigInt   @map("article_id") @db.UnsignedBigInt
  poiId     BigInt   @map("poi_id") @db.UnsignedBigInt
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  poi     Poi     @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@unique([articleId, poiId])
  @@map("article_poi")
}

model ArticleRoute {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  articleId BigInt   @map("article_id") @db.UnsignedBigInt
  routeId   BigInt   @map("route_id") @db.UnsignedBigInt
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  article Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  route   RouteTemplate @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([articleId, routeId])
  @@map("article_route")
}

model Banner {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title     String?   @db.VarChar(128)
  imageUrl  String    @map("image_url") @db.VarChar(512)
  linkType  String    @map("link_type") @db.VarChar(32)
  linkId    BigInt?   @map("link_id") @db.UnsignedBigInt
  linkPath  String?   @map("link_path") @db.VarChar(255)
  sortOrder Int       @default(0) @map("sort_order")
  startAt   DateTime? @map("start_at")
  endAt     DateTime? @map("end_at")
  status    Int       @default(1) @db.UnsignedTinyInt
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("banner")
}

model HomeHotDestination {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  destinationId   BigInt    @map("destination_id") @db.UnsignedBigInt
  coverOverride   String?   @map("cover_override") @db.VarChar(512)
  sortOrder       Int       @default(0) @map("sort_order")
  status          Int       @default(1) @db.UnsignedTinyInt
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId])
  @@map("home_hot_destination")
}

model HomeHotRoute {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  routeId       BigInt    @map("route_id") @db.UnsignedBigInt
  coverOverride String?   @map("cover_override") @db.VarChar(512)
  sortOrder     Int       @default(0) @map("sort_order")
  status        Int       @default(1) @db.UnsignedTinyInt
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  route RouteTemplate @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId])
  @@map("home_hot_route")
}

model User {
  userId    BigInt    @id @default(autoincrement()) @map("user_id") @db.UnsignedBigInt
  openid    String    @unique @db.VarChar(100)
  unionid   String?   @db.VarChar(100)
  avatarUrl String?   @map("avatar_url") @db.VarChar(500)
  nickname  String?   @db.VarChar(100)
  phone     String?   @unique @db.VarChar(20)
  email     String?   @db.VarChar(100)
  gender    Int?      @default(0) @db.UnsignedTinyInt
  birthday  DateTime? @db.Date
  signature String?   @db.VarChar(255)
  status    Int       @default(1) @db.UnsignedTinyInt
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  orders    Order[]
  reviews   Review[]
  travelers Traveler[]
  favorites Favorite[]
  footprints Footprint[]
  feedbacks  Feedback[]

  @@map("users")
}

model Order {
  orderId         BigInt    @id @default(autoincrement()) @map("order_id") @db.UnsignedBigInt
  orderNo         String    @unique @map("order_no") @db.VarChar(32)
  userId          BigInt    @map("user_id") @db.UnsignedBigInt
  productType     Int       @map("product_type") @db.UnsignedTinyInt
  productId       BigInt?   @map("product_id") @db.UnsignedBigInt
  productName     String    @map("product_name") @db.VarChar(255)
  productImage    String?   @map("product_image") @db.VarChar(500)
  quantity        Int?      @default(1) @db.UnsignedInt
  unitPrice       Decimal?  @default(0) @map("unit_price") @db.Decimal(12, 2)
  totalAmount     Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  discountAmount  Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  payAmount       Decimal   @default(0) @map("pay_amount") @db.Decimal(12, 2)
  status          Int       @default(1) @db.UnsignedTinyInt
  payTime         DateTime? @map("pay_time")
  travelDate      DateTime? @map("travel_date") @db.Date
  cancelTime      DateTime? @map("cancel_time")
  refundStatus    Int       @default(0) @map("refund_status") @db.UnsignedTinyInt
  snapshot        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user      User            @relation(fields: [userId], references: [userId])
  travelers OrderTraveler[]
  vouchers  OrderVoucher[]
  payments  Payment[]
  refunds   RefundRecord[]
  logs      OrderStatusLog[]
  reviews   Review[]

  @@index([userId, status], map: "idx_user_id_status")
  @@map("orders")
}

model OrderTraveler {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  orderId    BigInt   @map("order_id") @db.UnsignedBigInt
  travelerId BigInt?  @map("traveler_id") @db.UnsignedBigInt
  name       String   @db.VarChar(50)
  idType     Int?     @default(1) @map("id_type") @db.UnsignedTinyInt
  idNumber   String   @map("id_number") @db.VarChar(100)
  phone      String?  @db.VarChar(20)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([orderId], map: "idx_order_id")
  @@map("order_travelers")
}

model OrderVoucher {
  voucherId    BigInt    @id @default(autoincrement()) @map("voucher_id") @db.UnsignedBigInt
  orderId      BigInt    @map("order_id") @db.UnsignedBigInt
  qrcodeData   String?   @map("qrcode_data") @db.VarChar(255)
  qrcodeImage  String?   @map("qrcode_image") @db.VarChar(500)
  status       Int       @default(1) @db.UnsignedTinyInt
  useTime      DateTime? @map("use_time")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([orderId], map: "idx_order_id")
  @@map("order_vouchers")
}

model Payment {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  paymentNo        String    @unique @map("payment_no") @db.VarChar(64)
  orderId          BigInt    @map("order_id") @db.UnsignedBigInt
  userId           BigInt    @map("user_id") @db.UnsignedBigInt
  amount           Decimal   @db.Decimal(12, 2)
  payMethod        String?   @default("wxpay") @map("pay_method") @db.VarChar(32)
  wxTransactionId  String?   @map("wx_transaction_id") @db.VarChar(64)
  status           Int       @default(1) @db.UnsignedTinyInt
  paidAt           DateTime? @map("paid_at")
  rawNotify        Json?     @map("raw_notify")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [orderId])

  @@index([orderId], map: "idx_payment_order")
  @@map("payment")
}

model RefundRecord {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  orderId      BigInt    @map("order_id") @db.UnsignedBigInt
  paymentId    BigInt?   @map("payment_id") @db.UnsignedBigInt
  itemId       BigInt?   @map("item_id") @db.UnsignedBigInt
  refundAmount Decimal   @map("refund_amount") @db.Decimal(12, 2)
  reason       String?   @db.VarChar(255)
  status       Int       @default(1) @db.UnsignedTinyInt
  applyTime    DateTime  @default(now()) @map("apply_time")
  auditTime    DateTime? @map("audit_time")
  auditorId    BigInt?   @map("auditor_id") @db.UnsignedBigInt
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [orderId])

  @@index([orderId], map: "idx_order")
  @@map("refund_record")
}

model OrderStatusLog {
  logId      BigInt   @id @default(autoincrement()) @map("log_id") @db.UnsignedBigInt
  orderId    BigInt   @map("order_id") @db.UnsignedBigInt
  fromStatus Int?     @default(0) @map("from_status") @db.UnsignedTinyInt
  toStatus   Int      @map("to_status") @db.UnsignedTinyInt
  operator   String?  @default("system") @db.VarChar(50)
  remark     String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([orderId], map: "idx_order_id")
  @@map("order_status_logs")
}

model Review {
  reviewId    BigInt    @id @default(autoincrement()) @map("review_id") @db.UnsignedBigInt
  userId      BigInt    @map("user_id") @db.UnsignedBigInt
  orderId     BigInt    @unique @map("order_id") @db.UnsignedBigInt
  productType Int?      @map("product_type") @db.UnsignedTinyInt
  productId   BigInt?   @map("product_id") @db.UnsignedBigInt
  productName String?   @map("product_name") @db.VarChar(255)
  rating      Int       @default(5) @db.UnsignedTinyInt
  ratingLabel String?   @map("rating_label") @db.VarChar(50)
  content     String?   @db.Text
  images      Json?
  isAnonymous Int       @default(0) @map("is_anonymous") @db.UnsignedTinyInt
  status      Int       @default(1) @db.UnsignedTinyInt
  reviewTime  DateTime? @default(now()) @map("review_time")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user  User  @relation(fields: [userId], references: [userId])
  order Order @relation(fields: [orderId], references: [orderId])

  @@index([userId], map: "idx_user_id")
  @@index([productType, productId], map: "idx_product")
  @@map("reviews")
}

model Traveler {
  travelerId     BigInt    @id @default(autoincrement()) @map("traveler_id") @db.UnsignedBigInt
  userId         BigInt    @map("user_id") @db.UnsignedBigInt
  name           String    @db.VarChar(50)
  idType         Int?      @default(1) @map("id_type") @db.UnsignedTinyInt
  idNumber       String    @map("id_number") @db.VarChar(100)
  phone          String?   @db.VarChar(20)
  phoneAreaCode  String?   @default("+86") @map("phone_area_code") @db.VarChar(10)
  isDefault      Int?      @default(0) @map("is_default") @db.UnsignedTinyInt
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId], map: "idx_user_id")
  @@map("travelers")
}

model Favorite {
  favoriteId  BigInt    @id @default(autoincrement()) @map("favorite_id") @db.UnsignedBigInt
  userId      BigInt    @map("user_id") @db.UnsignedBigInt
  targetType  Int       @map("target_type") @db.UnsignedTinyInt
  targetId    BigInt    @map("target_id") @db.UnsignedBigInt
  targetName  String?   @map("target_name") @db.VarChar(255)
  targetImage String?   @map("target_image") @db.VarChar(500)
  extraInfo   Json?     @map("extra_info")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, targetType, targetId], map: "uk_user_target")
  @@index([targetType, targetId], map: "idx_target")
  @@map("favorites")
}

model Footprint {
  footprintId BigInt    @id @default(autoincrement()) @map("footprint_id") @db.UnsignedBigInt
  userId      BigInt    @map("user_id") @db.UnsignedBigInt
  poiId       BigInt?   @map("poi_id") @db.UnsignedBigInt
  poiName     String?   @map("poi_name") @db.VarChar(255)
  poiImage    String?   @map("poi_image") @db.VarChar(500)
  poiGrade    String?   @map("poi_grade") @db.VarChar(20)
  poiCategory String?   @map("poi_category") @db.VarChar(50)
  address     String?   @db.VarChar(255)
  cityName    String?   @map("city_name") @db.VarChar(50)
  visitDate   DateTime  @map("visit_date") @db.Date
  visitTime   DateTime? @map("visit_time") @db.Time(0)
  type        Int?      @default(1) @db.UnsignedTinyInt
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  poi  Poi? @relation(fields: [poiId], references: [id], onDelete: SetNull)

  @@index([userId, visitDate], map: "idx_user_id_date")
  @@index([poiId], map: "idx_poi_id")
  @@index([cityName], map: "idx_city")
  @@map("footprints")
}

model Feedback {
  feedbackId   BigInt    @id @default(autoincrement()) @map("feedback_id") @db.UnsignedBigInt
  userId       BigInt    @map("user_id") @db.UnsignedBigInt
  type         Int?      @default(1) @db.UnsignedTinyInt
  content      String    @db.Text
  images       Json?
  contact      String?   @db.VarChar(50)
  status       Int       @default(0) @db.UnsignedTinyInt
  replyContent String?   @map("reply_content") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId], map: "idx_user_id")
  @@map("feedback")
}
